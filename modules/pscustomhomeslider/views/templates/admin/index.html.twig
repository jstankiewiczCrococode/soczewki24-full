{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col-12">
            <div class="card">

                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-header-title">
                            {{ 'Slider strony głównej'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                        </h3>

                        <a
                            href="{{ path('admin_pscustomhomeslider_create') }}"
                            class="btn btn-primary"
                        >
                            <i class="material-icons">add</i>
                            {{ 'Dodaj slajd'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                        </a>
                    </div>
                </div>

                <div class="card-body">

                    {% if slides is empty %}

                        <div class="alert alert-info">
                            {{ 'Nie ma jeszcze żadnych slajdów.'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                        </div>

                    {% else %}

                        <div class="table-responsive">
                            <table class="table">

                                <thead>
                                    <tr>
                                        <th style="width: 80px;">
                                            {{ 'ID'|trans({}, 'Admin.Global') }}
                                        </th>

                                        <th style="width: 140px;">
                                            {{ 'Zdjęcie'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                                        </th>

                                        <th>
                                            {{ 'Tytuł'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                                        </th>

                                        <th style="width: 100px;">
                                            {{ 'Pozycja'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                                        </th>

                                        <th style="width: 120px;">
                                            {{ 'Status'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                                        </th>

                                        <th style="width: 180px;" class="text-right">
                                            {{ 'Akcje'|trans({}, 'Admin.Global') }}
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    {% for slide in slides %}

                                        <tr>

                                            <td>
                                                {{ slide.id_slide }}
                                            </td>

                                            <td>
                                                {% if slide.image %}

                                                    <img
                                                        src="{{ asset(
                                                            'img/pscustomhomeslider/' ~ slide.image
                                                        ) }}"
                                                        alt=""
                                                        style="
                                                            width: 120px;
                                                            height: 70px;
                                                            object-fit: cover;
                                                            border-radius: 4px;
                                                        "
                                                    >

                                                {% else %}

                                                    <div
                                                        class="text-muted"
                                                        style="
                                                            width: 120px;
                                                            height: 70px;
                                                            display: flex;
                                                            align-items: center;
                                                            justify-content: center;
                                                            background: #f5f5f5;
                                                            border-radius: 4px;
                                                        "
                                                    >
                                                        {{ 'Brak zdjęcia'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                                                    </div>

                                                {% endif %}
                                            </td>

                                            <td>
                                                {% if slide.title %}
                                                    <strong>
                                                        {{ slide.title }}
                                                    </strong>
                                                {% else %}
                                                    <span class="text-muted">
                                                        {{ 'Brak tytułu'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                                                    </span>
                                                {% endif %}
                                            </td>

                                            <td>
                                                {{ slide.position }}
                                            </td>

                                            <td>

                                                {% if slide.active %}

                                                    <span class="badge badge-success">
                                                        {{ 'Aktywny'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                                                    </span>

                                                {% else %}

                                                    <span class="badge badge-secondary">
                                                        {{ 'Nieaktywny'|trans({}, 'Modules.Pscustomhomeslider.Admin') }}
                                                    </span>

                                                {% endif %}

                                            </td>

                                            <td class="text-right">

                                                <a
                                                    href="{{ path(
                                                        'admin_pscustomhomeslider_edit',
                                                        {'id': slide.id_slide}
                                                    ) }}"
                                                    class="btn btn-outline-primary"
                                                    title="{{ 'Edytuj'|trans({}, 'Admin.Actions') }}"
                                                >
                                                    <i class="material-icons">edit</i>
                                                </a>

                                                <form
                                                    method="post"
                                                    action="{{ path(
                                                        'admin_pscustomhomeslider_delete',
                                                        {'id': slide.id_slide}
                                                    ) }}"
                                                    style="display: inline-block;"
                                                    onsubmit="return confirm(
                                                        '{{ 'Czy na pewno chcesz usunąć ten slajd?'|trans({}, 'Modules.Pscustomhomeslider.Admin')|e('js') }}'
                                                    );"
                                                >

                                                    <input
                                                        type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('delete_slide_' ~ slide.id_slide) }}"
                                                    >

                                                    <button
                                                        type="submit"
                                                        class="btn btn-outline-danger"
                                                        title="{{ 'Usuń'|trans({}, 'Admin.Actions') }}"
                                                    >
                                                        <i class="material-icons">delete</i>
                                                    </button>

                                                </form>

                                            </td>

                                        </tr>

                                    {% endfor %}

                                </tbody>

                            </table>
                        </div>

                    {% endif %}

                </div>
            </div>
        </div>
    </div>
{% endblock %}