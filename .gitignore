node_modules/
vendor/

# Sekrety i konfiguracja lokalna
.env
.env.local
/docker/data/
/bin/*.sql
/bin/*.sql.gz

# Smieci
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
