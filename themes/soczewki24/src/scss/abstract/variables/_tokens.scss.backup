// =====================================================================
// Design tokeny Soczewki24 - jedyne zrodlo prawdy dla wartosci z Figmy.
//
// ZASADA: kolor, spacing, radius, font ktory pojawia sie w kodzie
// MUSI byc zdefiniowany tutaj. Nie hardkodujemy #ff0000 w komponentach.
//
// Plik jest importowany jako pierwszy w abstract/variables/_index.scss,
// wiec nadpisuje zmienne Bootstrapa i Hummingbirda ponizej.
// =====================================================================

// --- Kolory marki -----------------------------------------------------
// TODO: podmienic na wartosci z Figmy
$socz-primary:          #0b69f6 !default;
$socz-primary-dark:     #0850c4 !default;
$socz-primary-light:    #e8f1fe !default;
$socz-secondary:        #212529 !default;
$socz-accent:           #ffb020 !default;

// --- Kolory semantyczne ----------------------------------------------
$socz-success:          #198754 !default;
$socz-warning:          #ffc107 !default;
$socz-danger:           #dc3545 !default;
$socz-info:             #0dcaf0 !default;

// --- Skala szarosci ---------------------------------------------------
$socz-gray-50:          #f8f9fa !default;
$socz-gray-100:         #f1f3f5 !default;
$socz-gray-300:         #dee2e6 !default;
$socz-gray-500:         #adb5bd !default;
$socz-gray-700:         #495057 !default;
$socz-gray-900:         #212529 !default;

// --- Typografia -------------------------------------------------------
// TODO: podmienic na krój z Figmy, dodac pliki do src/fonts + @font-face
$socz-font-sans:        "Inter", system-ui, -apple-system, "Segoe UI", sans-serif !default;
$socz-font-heading:     $socz-font-sans !default;

$socz-fs-xs:            0.75rem !default;   // 12px
$socz-fs-sm:            0.875rem !default;  // 14px
$socz-fs-base:          1rem !default;      // 16px
$socz-fs-lg:            1.125rem !default;  // 18px
$socz-fs-xl:            1.5rem !default;    // 24px
$socz-fs-2xl:           2rem !default;      // 32px
$socz-fs-3xl:           2.5rem !default;    // 40px

$socz-lh-tight:         1.2 !default;
$socz-lh-base:          1.5 !default;

// --- Spacing ----------------------------------------------------------
$socz-space-1:          0.25rem !default;
$socz-space-2:          0.5rem !default;
$socz-space-3:          1rem !default;
$socz-space-4:          1.5rem !default;
$socz-space-5:          2rem !default;
$socz-space-6:          3rem !default;

// --- Promienie i cienie ----------------------------------------------
$socz-radius-sm:        4px !default;
$socz-radius-md:        8px !default;
$socz-radius-lg:        16px !default;
$socz-radius-pill:      999px !default;

$socz-shadow-sm:        0 1px 2px rgba(0, 0, 0, 0.06) !default;
$socz-shadow-md:        0 4px 12px rgba(0, 0, 0, 0.08) !default;
$socz-shadow-lg:        0 12px 32px rgba(0, 0, 0, 0.12) !default;

// =====================================================================
// Mapowanie tokenow na zmienne Bootstrapa 5.3
// Dzieki temu komponenty Bootstrapa i Hummingbirda same przejmuja
// wyglad z Figmy, bez przepisywania kazdego z osobna.
// =====================================================================

$primary:               $socz-primary !default;
$secondary:             $socz-secondary !default;
$success:               $socz-success !default;
$warning:               $socz-warning !default;
$danger:                $socz-danger !default;
$info:                  $socz-info !default;

$font-family-sans-serif: $socz-font-sans !default;
$font-size-base:         $socz-fs-base !default;
$line-height-base:       $socz-lh-base !default;
$headings-font-family:   $socz-font-heading !default;
$headings-line-height:   $socz-lh-tight !default;

$border-radius:          $socz-radius-md !default;
$border-radius-sm:       $socz-radius-sm !default;
$border-radius-lg:       $socz-radius-lg !default;
$border-radius-pill:     $socz-radius-pill !default;

$box-shadow-sm:          $socz-shadow-sm !default;
$box-shadow:             $socz-shadow-md !default;
$box-shadow-lg:          $socz-shadow-lg !default;

// UWAGA dostepnosc (EAA/WCAG 2.1 AA):
// kazda para tekst/tlo z tokenow powyzej musi miec kontrast >= 4.5:1
// (>= 3:1 dla tekstu >= 24px). Sprawdzic przed wdrozeniem palety z Figmy.
